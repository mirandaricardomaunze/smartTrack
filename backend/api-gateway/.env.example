# API Gateway — Variáveis de Ambiente
# Copiar para .env e preencher os valores reais
# NUNCA commitar o .env

# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=4000

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Banco criado pelo usuário: "track"
PGHOST=localhost
PGPORT=5432
PGDATABASE=track
PGUSER=postgres
PGPASSWORD=postgres

# ─── Auth ────────────────────────────────────────────────────────────────────
# Spec ref: docs/spec/especificacao-tecnica-v1.md § 4 (Segurança — JWT)
JWT_SECRET=change_me_in_production

# ─── Rastreio Internacional (17TRACK) ────────────────────────────────────────
# Spec ref: docs/spec/especificacao-tecnica-v1.md § 6, § 3.10
# Com TRACK17_API_KEY definido, o rastreio usa a API REAL do 17TRACK.
# Sem a key, cai no simulador de desenvolvimento (dados NÃO reais).
TRACK17_API_KEY=
TRACK17_BASE_URL=https://api.17track.net/track/v2.2
TRACK17_TIMEOUT_MS=10000

# Polling em background (opcional). 'false' desliga.
TRACKING_POLL_ENABLED=true
TRACKING_POLL_INTERVAL_MS=300000
TRACKING_POLL_LIMIT=100

# O backend é um monólito modular. Não são necessárias URLs/portas internas
# para rotas, pagamentos, notificações, rastreio ou sincronização.
