# ─── Dependências ────────────────────────────
node_modules/
.npm/
.pnp/
.pnp.js

# ─── Build outputs ───────────────────────────
dist/
build/
.next/
out/
*.tsbuildinfo

# ─── Variáveis de Ambiente (NUNCA commitar) ──
# Regra abrangente: qualquer .env em qualquer pasta (raiz, backend/*, frontend/*,
# infra/docker) fica de fora. Só os modelos *.example são versionados — esses
# nunca levam valores reais, apenas as chaves vazias.
.env
.env.*
!.env.example
!.env.*.example

# ─── Logs ────────────────────────────────────
logs/
*.log
migrate-log.txt
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Cache ───────────────────────────────────
.turbo/
.cache/
.eslintcache
.parcel-cache/

# ─── Testes ──────────────────────────────────
coverage/
.nyc_output/

# ─── Mobile ──────────────────────────────────
