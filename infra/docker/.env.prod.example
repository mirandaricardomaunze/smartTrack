# Produção — copiar para infra/docker/.env.prod e preencher.
# NUNCA commitar o .env.prod (está no .gitignore).

# ─── Domínios (DNS público a apontar para o servidor) ────────────────────────
SITE_DOMAIN=cliente.seu-dominio.mz
API_DOMAIN=api.seu-dominio.mz

# URL PÚBLICA da API — embutida no build do cliente (browser chama esta URL).
NEXT_PUBLIC_API_URL=https://api.seu-dominio.mz
NEXT_PUBLIC_API_VERSION=v1

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
PGDATABASE=track
PGUSER=sistematrack
# Gerar uma senha forte, ex.: openssl rand -base64 24
PGPASSWORD=trocar_por_senha_forte

# ─── Segurança do backend (obrigatório em produção) ──────────────────────────
# Gerar, ex.: openssl rand -hex 32
JWT_SECRET=trocar_por_segredo_forte_de_32+_bytes
# Origens permitidas (o site do cliente e, se aplicável, o painel admin).
CORS_ORIGIN=https://cliente.seu-dominio.mz

# ─── Rastreio internacional (17TRACK) ────────────────────────────────────────
# Sem a key, o rastreio internacional cai no simulador (dados não reais).
TRACK17_API_KEY=
TRACKING_POLL_ENABLED=true
