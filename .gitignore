ios/
android/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/

# ─── Sistema ─────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo

# ─── IDEs e agentes ──────────────────────────
