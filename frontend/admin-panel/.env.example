# Admin Panel — Variáveis de Ambiente
# Copiar este arquivo como .env.local e preencher os valores reais
# NUNCA commitar .env.local

# URL base do API Gateway (backend)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Versão da API
NEXT_PUBLIC_API_VERSION=v1

# Habilita logs de debug no browser (apenas dev)
NEXT_PUBLIC_DEBUG=true

# Domínio do cookie de sessão (ajustar em produção)
# AUTH_COOKIE_DOMAIN=.smarttrack.co.mz
