# caminhos locais e PIDs de sessões antigas — não são configuração do projeto.
# A documentação para agentes fica em .agents/, que é versionada.
.claude/
.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

