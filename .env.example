# =============================================================================
# sistemaTrack — variáveis de ambiente (produção)
# =============================================================================
# Copie para `.env` e preencha. NUNCA faça commit do `.env` (só do `.example`).
# O backend é um monólito modular (um processo, uma base `track`).
# -----------------------------------------------------------------------------

# ── Núcleo ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
# Desliga explicitamente as contas de demonstração (já ficam off com NODE_ENV=production).
DISABLE_MOCK_ACCOUNTS=true

# ── Base de dados (PostgreSQL) ────────────────────────────────────────────────
PGHOST=db
PGPORT=5432
PGUSER=sistematrack
PGPASSWORD=troque-esta-senha-forte
PGDATABASE=track
# Usado pela imagem do Postgres (docker-compose) para criar a base inicial.
POSTGRES_PASSWORD=troque-esta-senha-forte

# ── Segurança (spec § 4) ──────────────────────────────────────────────────────
# OBRIGATÓRIO em produção. Gere um segredo forte, ex.: `openssl rand -hex 48`.
JWT_SECRET=
# Origens permitidas (CSV) — os domínios do painel, do site do cliente E DA APP
# DO MOTORISTA. Esquecer o do motorista faz a app dele levar erro de CORS em
# todos os pedidos: o ecrã abre e nada carrega, sem mensagem que explique.
CORS_ORIGIN=https://admin.example.com,https://app.example.com,https://motorista.example.com

# ── SUPERADMIN da plataforma (multi-tenant, spec § 2.4) ───────────────────────
# Usado por `npm run seed:superadmin` (as contas mock estão off em produção).
SUPERADMIN_EMAIL=plataforma@example.com
SUPERADMIN_PASSWORD=

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
COMPANY_REGISTER_RATE_LIMIT_MAX=5
SUPPORT_OPEN_RATE_LIMIT_MAX=8

# ── Faturação (spec § 3.14) — emissor e IVA ───────────────────────────────────
INVOICE_ISSUER_NAME=A Sua Empresa, Lda.
INVOICE_ISSUER_TAXID=400000000
INVOICE_ISSUER_ADDRESS=Av. 25 de Setembro, Maputo, Moçambique
INVOICE_ISSUER_EMAIL=faturacao@example.com
INVOICE_TAX_RATE_PCT=16

# ── Tarifação (spec § 3.13) ───────────────────────────────────────────────────
PRICING_EXPRESS_MULTIPLIER=1.5
PRICING_COD_SURCHARGE_PCT=0

# Multiplicador por modal de entrega (spec § 3.33). Sem estas variáveis valem os
# valores do catálogo; sem `vehicle_modal` no pedido de orçamento não há ajuste.
PRICING_MODAL_MOTO_MULTIPLIER=0.7
PRICING_MODAL_MOTOTRICICLO_MULTIPLIER=0.85
PRICING_MODAL_CARRO_MULTIPLIER=1
PRICING_MODAL_VAN_MULTIPLIER=1.3
PRICING_MODAL_CAMINHAO_MULTIPLIER=1.8


# ── Recursos Humanos — assiduidade (spec § 3.16) ──────────────────────────────
# Fuso do horário de trabalho em minutos (120 = UTC+2, Moçambique).
HR_TIMEZONE_OFFSET_MINUTES=120
# Turno de omissão para quem ainda não tem turno atribuído (hora local).
HR_SHIFT_START=09:00
HR_SHIFT_END=18:00
HR_SHIFT_BREAK_MINUTES=60

# ── Documentos PDF da empresa (spec § 3.20) ───────────────────────────────────
# Teto do logótipo em caracteres do data URL (~300 KB). O logótipo viaja dentro
# de cada PDF gerado — imagens grandes tornam os documentos pesados.
COMPANY_LOGO_MAX_CHARS=400000

# ── Conformidade fiscal (spec § 3.19) ─────────────────────────────────────────
# Série por omissão dos documentos (1 a 6 caracteres alfanuméricos).
FISCAL_DEFAULT_SERIES=A
# Identificação do software no documento e no ficheiro de auditoria.
FISCAL_SOFTWARE_VERSION=1.0
# Número de certificação atribuído pela AT. Deixe 0 enquanto não existir —
# nunca inventar um número: sai impresso no documento e no SAF-T.
FISCAL_SOFTWARE_CERTIFICATE=0
# Esquema do ficheiro de auditoria. Confirme o oficial de MZ junto da AT.
FISCAL_SAFT_NAMESPACE=urn:OECD:StandardAuditFile-Tax:MZ_1.0
FISCAL_SAFT_VERSION=1.0
# Cidade do emissor (cabeçalho do SAF-T).
INVOICE_ISSUER_CITY=Maputo



# ── Recuperação de senha (spec § 3.22) ───────────────────────────────────────
# Validade do link enviado por email, em minutos.
PASSWORD_RESET_TTL_MINUTES=60
# Teto de pedidos por conta e por hora.
PASSWORD_RESET_MAX_PER_HOUR=5
# Base do link no email — tem de apontar para o PAINEL, não para a API.
ADMIN_PUBLIC_URL=https://admin.example.com
# ── Registo de auditoria (spec § 3.21) ───────────────────────────────────────
# Teto do contexto guardado por evento. Corpos de pedido nunca são guardados.
AUDIT_METADATA_MAX_CHARS=4000
# ── Planos e subscrições — SaaS (spec § 2.5) ──────────────────────────────────
# Plano atribuído no auto-registo de uma empresa nova (começa em avaliação).
SAAS_DEFAULT_PLAN=starter
# Dias de tolerância com fatura por pagar antes de bloquear as escritas.
SAAS_PAST_DUE_GRACE_DAYS=7

# ── OTP de entrega (spec § 3.x) ───────────────────────────────────────────────
DELIVERY_OTP_TTL_MINUTES=240

# ── Rastreio internacional (spec § 3.10) ──────────────────────────────────────
# Com a key, usa o 17TRACK REAL; sem ela, cai no simulador determinístico.
TRACK17_API_KEY=
# Agendador de polling em background (opcional).
TRACKING_POLL_ENABLED=true
TRACKING_POLL_INTERVAL_MS=900000
TRACKING_POLL_LIMIT=50

# ── Push / SMS / Email ao cliente (spec § 3.3) ────────────────────────────────
# Sem estas variáveis, os canais ficam SIMULADOS (nada é enviado de facto).
# Push via FCM (API HTTP v1): as TRÊS são obrigatórias juntas. Vêm do JSON da
# service account do Firebase; a chave privada leva os \n escapados e aspas.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FCM_TIMEOUT_MS=10000
SMS_API_URL=
SMS_API_KEY=
SMS_TIMEOUT_MS=8000
# Recomendado: Resend. O domínio do remetente deve estar verificado no painel.
RESEND_API_KEY=
EMAIL_FROM=SistemaTrack <notificacoes@example.com>
# Alternativa compatível: endpoint HTTP genérico.
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_TIMEOUT_MS=8000

# ── Frontends (Next.js) — inlined no BUILD ────────────────────────────────────
# URL pública da API (via reverse proxy). Definir ANTES de `next build`.
NEXT_PUBLIC_API_URL=https://api.example.com

# ── Domínios (usados pelo Caddyfile / compose) ────────────────────────────────
DOMAIN_API=api.example.com
DOMAIN_ADMIN=admin.example.com
DOMAIN_APP=app.example.com
# App do motorista. Domínio próprio porque é uma PWA: o service worker e a
# instalação no telemóvel ficam presos à origem onde a app é servida.
DOMAIN_DRIVER=motorista.example.com
# Email para os certificados TLS automáticos (Let's Encrypt via Caddy).
ACME_EMAIL=admin@example.com

# ── Cópias de segurança (spec § 4) ────────────────────────────────────────────
# Onde ficam as cópias. Fora da pasta do projeto, para não irem num commit.
BACKUP_DIR=/var/backups/sistematrack
# Como a cópia sai da máquina. {file} é substituído pelo caminho do ficheiro.
# Sem isto, a cópia fica apenas no disco que mais provavelmente falha.
BACKUP_UPLOAD_CMD=
# Retenção: mais recente de cada dia, semana e mês.
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
# Base descartável usada no ensaio de restauro (nunca a de produção).
BACKUP_VERIFY_DB=sistematrack_restore_check
